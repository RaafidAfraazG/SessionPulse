# SessionPulse Client — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
#
# All variables must be prefixed with VITE_ to be exposed to the browser.
# See: https://vitejs.dev/guide/env-and-mode.html

# ── API ──────────────────────────────────────────────────────────────────────
# Full base URL of the SessionPulse backend API.
# In development, leave this blank — Vite proxies /api to localhost:5000.
# In production, point this to your Render (or other) backend URL.
#
# Example:
# VITE_API_URL=https://sessionpulse-api.onrender.com/api

VITE_API_URL=
