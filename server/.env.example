# ─── Environment ──────────────────────────────────────────────────────────────
# Server port
PORT=5000

# MongoDB connection string (local or Atlas)
# Local:  mongodb://localhost:27017/sessionpulse
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/sessionpulse
MONGO_URI=mongodb://localhost:27017/sessionpulse

# Application environment: development | production
NODE_ENV=development

# Allowed CORS origin(s). Use * to allow all, or specify a domain.
# Example: http://localhost:3000
CORS_ORIGIN=*
